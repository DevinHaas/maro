{
  "version": "1.0",
  "status": "Foundation approved 2026-10-04; native implementation pending",
  "name": "Maro / Tidal",
  "scope": "Cosmetic styling only; all existing layout and interaction geometry are immutable.",
  "primitives": {
    "color": {
      "abyss": "#0B151A",
      "ocean": "#10232B",
      "lagoon": "#18323B",
      "hover": "#21434C",
      "selected": "#1D4547",
      "foam": "#DDF1F0",
      "muted": "#A0BDC4",
      "mint": "#91DAB8",
      "mintHover": "#ABEDCE",
      "mintPressed": "#79C9A7",
      "cyan": "#82CDDF",
      "cyanHover": "#A4E5ED",
      "cyanPressed": "#71BACA",
      "focus": "#B5F3E8",
      "divider": "#2B4A54",
      "control": "#729CA6",
      "disabled": "#78949E",
      "error": "#F0A0A0",
      "warning": "#E5C78D"
    },
    "font": {
      "mono": "JetBrains Mono",
      "fallback": "SF Mono, Menlo, monospace",
      "system": "system UI for unsupported scripts and platform text"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "paint": {
      "border": 1,
      "focusInset": 2,
      "panelOpacityWithImage": 0.92,
      "blur": 18,
      "hoverDurationMs": 120
    }
  },
  "semantic": {
    "surface": {
      "canvas": "{primitives.color.abyss}",
      "panel": "{primitives.color.ocean}",
      "raised": "{primitives.color.lagoon}",
      "hover": "{primitives.color.hover}",
      "selected": "{primitives.color.selected}"
    },
    "text": {
      "primary": "{primitives.color.foam}",
      "secondary": "{primitives.color.muted}",
      "onAccent": "{primitives.color.abyss}",
      "disabled": "{primitives.color.disabled}"
    },
    "accent": {
      "primary": "{primitives.color.mint}",
      "hover": "{primitives.color.mintHover}",
      "pressed": "{primitives.color.mintPressed}",
      "secondary": "{primitives.color.cyan}"
    },
    "border": {
      "decorative": "{primitives.color.divider}",
      "interactive": "{primitives.color.control}",
      "focus": "{primitives.color.focus}"
    },
    "status": {
      "success": "{primitives.color.mint}",
      "info": "{primitives.color.cyan}",
      "warning": "{primitives.color.warning}",
      "error": "{primitives.color.error}"
    }
  },
  "components": {
    "button": {
      "primaryBackground": "{semantic.accent.primary}",
      "primaryForeground": "{semantic.text.onAccent}",
      "hoverBackground": "{semantic.accent.hover}",
      "pressedBackground": "{semantic.accent.pressed}",
      "secondaryBackground": "{semantic.surface.raised}",
      "secondaryBorder": "{semantic.border.interactive}",
      "focus": "{semantic.border.focus}"
    },
    "search": {
      "background": "{semantic.surface.raised}",
      "text": "{semantic.text.primary}",
      "placeholder": "{semantic.text.secondary}",
      "border": "{semantic.border.interactive}",
      "focus": "{semantic.border.focus}"
    },
    "row": {
      "background": "transparent",
      "hover": "{semantic.surface.hover}",
      "selected": "{semantic.surface.selected}",
      "activeTitle": "{semantic.accent.primary}",
      "text": "{semantic.text.primary}",
      "metadata": "{semantic.text.secondary}"
    },
    "player": {
      "background": "{semantic.surface.canvas}",
      "progress": "{semantic.accent.primary}",
      "track": "{semantic.border.interactive}",
      "time": "{semantic.text.secondary}"
    },
    "artwork": {
      "fallback": "{semantic.surface.raised}",
      "placeholder": "{semantic.accent.secondary}",
      "favoritesGradient": [
        "{primitives.color.lagoon}",
        "{primitives.color.cyan}"
      ],
      "treatment": "Original, full color; preserve crop, bounds and loading behavior."
    }
  },
  "geometry": {
    "policy": "LOCKED; descriptive baseline values, never theme overrides",
    "coordinateUnit": "SwiftUI points",
    "topBarHeight": 64,
    "sidebarWidthBelow1200": 280,
    "sidebarWidthAtLeast1200": 320,
    "panelGap": 8,
    "outerHorizontalPadding": 8,
    "bottomPadding": 4,
    "playerHeight": 88,
    "globalSearchHeight": 44,
    "globalSearchMaxWidth": 520,
    "standardIconButtonSize": 38,
    "homeHoverPlaySize": 44,
    "playlistPlaySize": 62,
    "homeHeroHeight": 260,
    "playlistHeroHeight": 320,
    "homeCardWidth": 196,
    "homeArtworkSize": 176,
    "libraryArtworkSize": 50,
    "playlistRowArtworkSize": 44,
    "cornerRadius": "Keep each current component's painted radius (5/6/8, circles, capsules)",
    "typeSize": "Keep each current role's point size, line limits, baselines and containing frame"
  },
  "customization": {
    "now": "Approved default blue-green foundation; preview controls demonstrate future customization.",
    "futureEditable": [
      "Semantic colors",
      "Font within fixed metric constraints",
      "Background image, crop and tint",
      "Panel opacity 0.92–1.0 when an image is enabled",
      "Blur and decorative effects"
    ],
    "neverEditableThroughTheme": [
      "Position",
      "Panel dimensions",
      "Control bounds or hit regions",
      "Padding, spacing, density",
      "Breakpoints",
      "Routes, keyboard behavior and playback"
    ],
    "defaults": {
      "backgroundImage": null,
      "decorativeGlow": false,
      "scanlines": false,
      "animatedWallpaper": false,
      "reducedTransparency": "Opaque surfaces",
      "reducedMotion": "No transitions beyond existing functional feedback"
    }
  }
}
